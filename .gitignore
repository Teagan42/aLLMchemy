# The operator's credentials land here. Secrets must be unstageable before they exist,
# per playbook/autonomy-contract.md — not after someone notices.
.env*
!.env.example

# Run output: verify.sh artifacts and launcher transcripts. intake.yaml is deliberately
# absent here — QUESTIONNAIRE.md commits it and keeps only the credentials file out.
artifacts/

# dev/test.sh's `secrets` suite plants a fake live Stripe key to prove the scanner fires.
# Its trap removes it, but a trap cannot run on SIGKILL, so this is the belt to that brace:
# a crashed test run must never leave a live-shaped key that `git add -A` would commit.
devtest-planted-secret-*

# Products are built outside this repo and are their own repositories. This is the belt to
# that brace: bin/run-factory.sh refuses an in-tree product dir, and if one ever appears
# anyway it must not be committable into the factory's history.
projects/
